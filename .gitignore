# Hugo's build output and caches — these are regenerated every build,
# so they should never be committed.
public/
resources/
.hugo_build.lock

# macOS clutter
.DS_Store

# Agent worktrees (isolated checkouts, never part of the site)
.claude/worktrees/

# Local verification screenshots, never part of the site
.shots/

# Node (only used to rebuild static/css/site.css)
node_modules/
